# ==============================================================================
# MARKETLINK BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# DEBUG defaults to False when missing: keep DEBUG=True for local development.
# With DEBUG=False the app refuses to start without its own SECRET_KEY.
SECRET_KEY=django-insecure-marketlink-local-development-only
DEBUG=True
# Deploy: list the real host names only (never "*").
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Reverse proxy & HTTPS ---
# Number of proxies in front of the app. Local: 0. Render: 1 (required, otherwise every
# user shares one login throttle bucket, or clients can fake their IP).
NUM_PROXIES=0
# Only used when DEBUG=False (behind the Render HTTPS proxy).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# --- Database Configuration (MySQL 8.x Community Server - InnoDB) ---
DB_NAME=marketlink_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=0

# --- Redis & Cache Configuration ---
USE_REDIS=False
# Local: redis://127.0.0.1:6379/0 - Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS & Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email Service (Console backend for local test, Gmail SMTP for demo) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MarketLink <no-reply@marketlink.vn>
EMAIL_TIMEOUT=10
# Set False when running pytest so emails are sent synchronously
EMAIL_ASYNC=True

# --- Geocoding (D-032, OpenStreetMap Nominatim) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Nominatim policy: identify the app and give a contact email, e.g. MarketLink/1.0 (team@example.com)
NOMINATIM_USER_AGENT=
GEOCODING_ENABLED=True

# --- Realtime WebSocket Ticket ---
WS_TICKET_TTL=30

# --- Gemini AI Chatbot API ---
GEMINI_API_KEY=
AI_CHAT_ENABLED=True

# --- Seed data (python manage.py seed_minimal) ---
# Leave empty locally to use the dev defaults; both are required when DEBUG=False.
SEED_ADMIN_EMAIL=admin@marketlink.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
